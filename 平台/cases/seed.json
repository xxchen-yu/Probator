    "input": "学校对研究生国家奖学金的名额分配是怎么规定的？",
    "assert": {
      "status": 200,
      "expect_no_coverage": true,
      "answer_contains": [
        [
          "没有",
          "未收录",
          "查不到",
          "未找到",
          "暂无"
        ]
      ],
      "answer_not_contains": [
        "名额为",
        "比例为",
        "百分之",
        "%"
      ],
      "citation_required": false
    },
    "meta": {
      "severity": "major",
      "root_cause": "模型在无覆盖时产生幻觉，凭空编造政策条款与数字"
    }
  },
