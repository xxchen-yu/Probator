[
  {
    "id": "F-001",
    "dimension": "functional",
    "priority": "P0",
    "title": "课表查询应返回本周全部课程且参数正确",
    "input": "请查询我本周的课程安排",
    "assert": {
      "tools_called": [
        "query_course_schedule"
      ],
      "tool_status": {
        "query_course_schedule": "success"
      },
      "tool_args_contains": {
        "query_course_schedule": {
          "week": 12
        }
      },
      "answer_contains": [
        "高等数学",
        "Python",
        "数据结构"
      ],
      "max_latency_ms": 20000
    },
    "judge": {
      "enabled": true,
      "min": 3
    },
    "meta": {
      "severity": "major",
      "root_cause": "规划层：工具参数抽取"
    }
  },
  {
    "id": "F-002",
    "dimension": "functional",
    "priority": "P0",
    "title": "校园卡补办材料应答完整且金额正确",
    "input": "补办校园卡需要什么材料？",
    "assert": {
      "tools_called": [
        "query_card_policy"
      ],
      "answer_contains": [
        "身份证",
        "学生证",
        [
          "20 元",
          "20元"
        ]
      ],
      "answer_not_contains": [
        "10 元",
        "10元",
        "当场取卡"
      ],
      "citations_include": [
        "校园卡管理办法.md"
      ],
      "citations_exclude": [
        "旧版"
      ]
    },
    "judge": {
      "enabled": true,
      "min": 3
    },
    "meta": {
      "severity": "blocker",
      "root_cause": "RAG：检索到过期条款 / 数值幻觉"
    }
  },
  {
