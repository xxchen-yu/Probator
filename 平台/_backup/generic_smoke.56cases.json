          "week": [
            8,
            "8",
            "第八周"
          ]
        }
      },
      "tool_status": {
        "query_course_schedule": "ok"
      },
      "answer_regex": "(周|星期)",
      "min_answer_chars": 10
    },
    "meta": {
      "severity": "blocker",
      "root_cause": "课表查询工具未被调用或教学周槽位未正确解析"
