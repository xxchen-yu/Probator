# 复制为 .env 后填写。真实 API Key 只保存在本地，不要提交到 GitHub。
# 云端服务必须填写 OpenAI-compatible 的完整 Chat Completions 地址和 API Key；本地 Ollama 可不填真实 Key。
MODEL_API_URL=https://api.deepseek.com/v1/chat/completions
MODEL_API_KEY=sk-your-key-here
MODEL_NAME=deepseek-chat

# 可选
MODEL_TEMPERATURE=0.2
MODEL_TIMEOUT=60
AGENT_HOST=127.0.0.1
AGENT_PORT=8000
